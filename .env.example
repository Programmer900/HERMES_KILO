# Backend environment variables
NODE_ENV=development
PORT=3001

# Database
POSTGRES_DB=hermes_db
POSTGRES_USER=hermes
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DATABASE_URL="postgresql://hermes:CHANGE_ME_USE_A_STRONG_PASSWORD@postgres:5432/hermes_db?schema=public"

# Redis
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Telegram Stars Payments
TELEGRAM_PAYMENT_TOKEN=your_payment_token_here

# CORS — set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# App
APP_NAME=HERMES_KILO
APP_VERSION=1.0.0
